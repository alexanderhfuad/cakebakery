# Environment Configuration for Hostinger
# 
# ⚠️ IMPORTANT SECURITY:
# - Copy this file to .env on the server
# - Update all values with YOUR actual credentials
# - NEVER commit .env to git
# - Set permission: chmod 600 .env
# - Add to .gitignore: *.env
#

# ============ SERVER CONFIGURATION ============
NODE_ENV=production
PORT=3001

# ============ CLIENT CONFIGURATION ============
# The frontend URL - update this to your domain
CLIENT_URL=https://yourdomain.com

# ============ SUPABASE CONFIGURATION ============
# Get these from: https://app.supabase.com/projects
# 1. Go to Project Settings → API
# 2. Copy "Project URL" and "Service Role Key"

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============ OPTIONAL: DATABASE CONFIGURATION ============
# If using direct database instead of Supabase
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ============ OPTIONAL: MAIL SERVICE ============
# For sending emails from contact form
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=your-email@yourdomain.com
# SMTP_PASSWORD=your-smtp-password
# ADMIN_EMAIL=admin@yourdomain.com

# ============ OPTIONAL: LOGGING ============
LOG_LEVEL=info
LOG_FILE=/home/user/logs/app.log

# ============ OPTIONAL: SECURITY ============
# CORS_ORIGIN=https://yourdomain.com
# API_RATE_LIMIT=100  # requests per 15 minutes per IP

# ============ DEBUG MODE (set to false in production) ============
DEBUG=false
